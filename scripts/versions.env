# Marionette installer version pins (sourced by scripts/install.sh and install.ps1).
# Bump these together when upgrading toolchain downloads.

MARIONETTE_NODE_VERSION=22.14.0
MARIONETTE_NODE_MIN_MAJOR=20

# MinGit for Windows portable git (https://github.com/git-for-windows/git/releases).
MARIONETTE_MINGIT_VERSION=2.55.0

# SHA256 checksums for verified downloads (leave empty to skip verification).
MARIONETTE_NODE_SHA256_WIN_X64=55b639295920b219bb2acbcfa00f90393a2789095b7323f79475c9f34795f217
MARIONETTE_NODE_SHA256_WIN_ARM64=2d71f5f9b2fffa33baa108c07d74b0d24e0c3dd8f441d567772ae0e3dd4b1a22
MARIONETTE_MINGIT_SHA256_WIN_X64=31497e7968196332263459ee319d2524e3ebc5786ab895e2abad34ffdd4f4ebf
MARIONETTE_MINGIT_SHA256_WIN_ARM64=377e283290e2de455cdd5cdbd99653bd911db752a8986d1ad914a5ac2fbd1192

# uv (Python toolchain manager). Installers download the IMMUTABLE versioned
# release asset for this exact version and verify it against the hash below
# before extracting -- never `curl https://astral.sh/uv/install.sh | sh`, whose
# bytes are mutable and therefore unpinnable.
#
# Refresh: bump MARIONETTE_UV_VERSION, then read each new hash from
#   https://github.com/astral-sh/uv/releases/download/<version>/uv-<target>.tar.gz.sha256
#   https://github.com/astral-sh/uv/releases/download/<version>/uv-<target>.zip.sha256
MARIONETTE_UV_VERSION=0.12.16
MARIONETTE_UV_SHA256_DARWIN_ARM64=b6e03fae61704b1aa622f12b792a69483e837b83068e44f4fd34f8a07a8f74a3
MARIONETTE_UV_SHA256_DARWIN_X64=a42bcc9ce97eb8b364d7f162233a9c6b8c0ee25388e551d362809795127e0c31
MARIONETTE_UV_SHA256_LINUX_ARM64=36d913ee9c647481d64f1a0a0485f85ff2feaee605c341fc22e73398f9212c26
MARIONETTE_UV_SHA256_LINUX_X64=8e5c6e5523dffc2dcf615bd995554c84c9feb4e577808a3fb8698a639d3f8d9c
MARIONETTE_UV_SHA256_WIN_X64=f730454bf09019754e5e5abd71a8aa18683cb739cba0d9c720bac2e7c901160f
MARIONETTE_UV_SHA256_WIN_ARM64=9977129f89c4036edfcb200d2484755571e51fa74517f02e478c1d7bcc353b2e
